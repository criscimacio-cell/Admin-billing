# PostgreSQL connection string (Supabase / Neon free tier, or local Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/stashhq

# JWT signing secret — use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Outbound email (Resend or SendGrid free-tier SMTP relay both work here)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-api-key
EMAIL_FROM="StashHQ <noreply@stash.ph>"
